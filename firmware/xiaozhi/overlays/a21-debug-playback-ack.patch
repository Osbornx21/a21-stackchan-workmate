diff --git a/main/protocols/protocol.cc b/main/protocols/protocol.cc
index 470cc91..41cbece 100644
--- a/main/protocols/protocol.cc
+++ b/main/protocols/protocol.cc
@@ -80,0 +81,33 @@ void Protocol::SendMcpMessage(const std::string& payload) {
+void Protocol::SendA21PlaybackStart() {
+    SendA21PlaybackEvent("start");
+}
+
+void Protocol::SendA21PlaybackStopDone() {
+    SendA21PlaybackEvent("stop_done");
+}
+
+void Protocol::SendA21PlaybackEvent(const char* playback) {
+    if (!a21_debug_device_events_allowed_) {
+        return;
+    }
+    cJSON* root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "type", "device");
+    cJSON_AddStringToObject(root, "kind", "playback");
+    cJSON_AddStringToObject(root, "playback", playback);
+    if (!trace_id_.empty()) {
+        cJSON_AddStringToObject(root, "trace_id", trace_id_.c_str());
+    }
+    if (!session_id_.empty()) {
+        cJSON_AddStringToObject(root, "session_id", session_id_.c_str());
+    }
+    if (!device_id_.empty()) {
+        cJSON_AddStringToObject(root, "device_id", device_id_.c_str());
+    }
+    auto json_str = cJSON_PrintUnformatted(root);
+    if (json_str != nullptr) {
+        SendText(json_str);
+        cJSON_free(json_str);
+    }
+    cJSON_Delete(root);
+}
+

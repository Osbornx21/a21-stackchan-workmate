diff --git a/main/protocols/websocket_protocol.cc b/main/protocols/websocket_protocol.cc
index 4b74a5e..37bb70e 100644
--- a/main/protocols/websocket_protocol.cc
+++ b/main/protocols/websocket_protocol.cc
@@ -212,0 +213,3 @@ std::string WebsocketProtocol::GetHelloMessage() {
+#if CONFIG_A21_DEBUG_DEVICE_EVENTS
+    cJSON_AddBoolToObject(features, "device_events", true);
+#endif
@@ -239,0 +243,21 @@ void WebsocketProtocol::ParseServerHello(const cJSON* root) {
+    auto trace_id = cJSON_GetObjectItem(root, "trace_id");
+    if (cJSON_IsString(trace_id)) {
+        trace_id_ = trace_id->valuestring;
+    }
+    auto device_id = cJSON_GetObjectItem(root, "device_id");
+    if (cJSON_IsString(device_id)) {
+        device_id_ = device_id->valuestring;
+    }
+
+    a21_debug_device_events_allowed_ = false;
+#if CONFIG_A21_DEBUG_DEVICE_EVENTS
+    auto a21 = cJSON_GetObjectItem(root, "a21");
+    if (cJSON_IsObject(a21)) {
+        auto profile = cJSON_GetObjectItem(a21, "profile");
+        auto device_events = cJSON_GetObjectItem(a21, "device_events");
+        a21_debug_device_events_allowed_ =
+            cJSON_IsString(profile) &&
+            strcmp(profile->valuestring, "debug") == 0 &&
+            cJSON_IsTrue(device_events);
+    }
+#endif

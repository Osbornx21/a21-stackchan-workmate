+void Application::HandleVadChange(bool speaking) {
+    if (GetDeviceState() != kDeviceStateListening) {
+        return;
+    }
+
+    if (speaking) {
+        vad_speech_seen_ = true;
+        if (vad_stop_timer_handle_ != nullptr) {
+            esp_timer_stop(vad_stop_timer_handle_);
+        }
+        return;
+    }
+
+    if (listening_mode_ != kListeningModeAutoStop) {
+        return;
+    }
+
+    if (!vad_speech_seen_ || vad_stop_timer_handle_ == nullptr) {
+        return;
+    }
+
+    int64_t elapsed_ms = (esp_timer_get_time() - listening_started_at_us_) / 1000;
+    int64_t delay_ms = A21_VAD_STOP_DEBOUNCE_MS;
+    if (elapsed_ms < A21_VAD_MIN_LISTENING_MS) {
+        delay_ms += A21_VAD_MIN_LISTENING_MS - elapsed_ms;
+    }
+    esp_timer_stop(vad_stop_timer_handle_);
+    esp_timer_start_once(vad_stop_timer_handle_, delay_ms * 1000);
+    ESP_LOGI(TAG, "A21 device VAD silence detected, stop in %lld ms", (long long)delay_ms);
+}
+
+void Application::HandleVadStopTimeoutEvent() {
+    if (GetDeviceState() != kDeviceStateListening || vad_speaking_) {
+        return;
+    }
+
+    int64_t elapsed_ms = (esp_timer_get_time() - listening_started_at_us_) / 1000;
+    if (!vad_speech_seen_) {
+        ESP_LOGI(TAG, "A21 no-speech timeout, stop listening elapsed=%lld ms", (long long)elapsed_ms);
+        StopListening();
+        return;
+    }
+
+    if (listening_mode_ != kListeningModeAutoStop) {
+        return;
+    }
+
+    if (elapsed_ms < A21_VAD_MIN_LISTENING_MS && vad_stop_timer_handle_ != nullptr) {
+        int64_t delay_ms = A21_VAD_MIN_LISTENING_MS - elapsed_ms + A21_VAD_STOP_DEBOUNCE_MS;
+        esp_timer_start_once(vad_stop_timer_handle_, delay_ms * 1000);
+        return;
+    }
+
+    ESP_LOGI(TAG, "A21 device VAD stop listening elapsed=%lld ms", (long long)elapsed_ms);
+    StopListening();
+}
+
 void Application::SetListeningMode(ListeningMode mode) {
     listening_mode_ = mode;
+    listening_started_at_us_ = esp_timer_get_time();
+    vad_speaking_ = false;
+    vad_speech_seen_ = false;
+    if (vad_stop_timer_handle_ != nullptr) {
+        esp_timer_stop(vad_stop_timer_handle_);
+    }
+    if (mode != kListeningModeRealtime && vad_stop_timer_handle_ != nullptr) {
+        esp_timer_start_once(vad_stop_timer_handle_, A21_NO_SPEECH_LISTENING_TIMEOUT_MS * 1000);
+    }
     SetDeviceState(kDeviceStateListening);
 }


+void Application::EnsureA21ControlChannel() {
+#if CONFIG_A21_STACKCHAN_KEEP_CONTROL_CHANNEL
+    if (!protocol_) {
+        return;
+    }
+    if (protocol_->IsAudioChannelOpened()) {
+        if (!protocol_->SendA21Keepalive()) {
+            ESP_LOGW(TAG, "A21 quiet control websocket heartbeat failed");
+            protocol_->CloseAudioChannel(false);
+            a21_ready_notified_ = false;
+        }
+        return;
+    }
+    if (GetDeviceState() != kDeviceStateIdle) {
+        return;
+    }
+
+    auto display = Board::GetInstance().GetDisplay();
+    if (!a21_ready_notified_) {
+        display->SetChatMessage("system", "正在连接紫悦服务...");
+    }
+    ESP_LOGI(TAG, "A21 keeping quiet control websocket open");
+    if (!protocol_->OpenAudioChannel()) {
+        ESP_LOGW(TAG, "A21 quiet control websocket open failed");
+        if (!a21_control_retry_notified_) {
+            display->ShowNotification("紫悦服务连接中，请稍等", 30000);
+            display->SetChatMessage("system", "正在连接紫悦服务...");
+            a21_control_retry_notified_ = true;
+        }
+        return;
+    }
+    a21_control_retry_notified_ = false;
+    if (!a21_ready_notified_) {
+        display->ShowNotification("紫悦已就绪", 5000);
+        display->SetChatMessage("system", "紫悦已就绪，可以叫我");
+        a21_ready_notified_ = true;
+    }
+    SetDeviceState(kDeviceStateIdle);
+#endif
+}
+
+void Application::HandleA21ScreenTouchEvent() {
+#if CONFIG_A21_PRODUCT_TOUCH_EVENTS
+    if (!protocol_) {
+        return;
+    }
+    if (GetDeviceState() == kDeviceStateSpeaking) {
+        protocol_->SendA21TouchEvent("screen_barge_in", "screen");
+        AbortSpeaking(kAbortReasonNone);
+        return;
+    }
+    protocol_->SendA21TouchEvent("screen_tap", "screen");
+    HandleStartListeningEvent();
+#endif
+}
+
+void Application::HandleA21HeadPetGesture(HeadPetGesture gesture) {
+#if CONFIG_A21_PRODUCT_TOUCH_EVENTS
+    if (!protocol_) {
+        return;
+    }
+    switch (gesture) {
+        case HeadPetGesture::SwipeForward:
+            a21_head_touch_swiped_ = true;
+            protocol_->SendA21TouchEvent("top_swipe_forward", "top_sensor");
+            return;
+        case HeadPetGesture::SwipeBackward:
+            a21_head_touch_swiped_ = true;
+            protocol_->SendA21TouchEvent("top_swipe_backward", "top_sensor");
+            return;
+        case HeadPetGesture::Release:
+            if (a21_head_touch_swiped_) {
+                a21_head_touch_swiped_ = false;
+                return;
+            }
+            if (GetDeviceState() == kDeviceStateSpeaking) {
+                protocol_->SendA21TouchEvent("top_barge_in", "top_sensor");
+                AbortSpeaking(kAbortReasonNone);
+                return;
+            }
+            protocol_->SendA21TouchEvent("top_tap", "top_sensor");
+            HandleStartListeningEvent();
+            return;
+        default:
+            return;
+    }
+#else
+    (void)gesture;
+#endif
+}

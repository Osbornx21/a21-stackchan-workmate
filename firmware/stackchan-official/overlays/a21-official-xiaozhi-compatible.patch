+        cJSON_AddStringToObject(root, "device_id", device_id_.c_str());
+    }
+    auto json_str = cJSON_PrintUnformatted(root);
+    bool sent = false;
+    if (json_str != nullptr) {
+        sent = SendText(json_str);
+        cJSON_free(json_str);
+    }
+    cJSON_Delete(root);
+    return sent;

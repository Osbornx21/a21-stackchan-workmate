+constexpr const char* kTag = "A21OfficialAudioSmoke";
+constexpr double kPi = 3.14159265358979323846;
+constexpr int kChunkFrames = 512;
+
+void playTone(AudioCodec& codec, int frequency_hz, int duration_ms, int amplitude)
+{
+    const int sample_rate = codec.output_sample_rate() > 0 ? codec.output_sample_rate() : AUDIO_OUTPUT_SAMPLE_RATE;
+    const int total_frames = sample_rate * duration_ms / 1000;
+    std::vector<int16_t> chunk;
+    chunk.reserve(kChunkFrames);
+
+    for (int frame = 0; frame < total_frames;) {
+        const int frames_to_write = std::min(kChunkFrames, total_frames - frame);
+        chunk.resize(frames_to_write);
+        for (int i = 0; i < frames_to_write; ++i) {
+            const double phase = 2.0 * kPi * static_cast<double>(frequency_hz) *
+                                 static_cast<double>(frame + i) / static_cast<double>(sample_rate);
+            chunk[i] = static_cast<int16_t>(std::sin(phase) * static_cast<double>(amplitude));
+        }
+        codec.OutputData(chunk);
+        frame += frames_to_write;
+    }
+}
+
+void idleWithWatchdog()
+{
+    while (true) {
+        GetHAL().feedTheDog();
+        vTaskDelay(pdMS_TO_TICKS(1000));
+    }
+}

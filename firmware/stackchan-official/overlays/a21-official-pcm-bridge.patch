+void idleDelay(int delay_ms)
+{
+    const int step_ms = 50;
+    int elapsed = 0;
+    while (elapsed < delay_ms) {
+        GetHAL().feedTheDog();
+        vTaskDelay(pdMS_TO_TICKS(step_ms));
+        elapsed += step_ms;
+    }
+}

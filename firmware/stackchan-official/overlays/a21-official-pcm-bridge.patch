+std::string jsonEscape(const std::string& value)
+{
+    std::string escaped;
+    escaped.reserve(value.size() + 8);
+    for (char ch : value) {
+        switch (ch) {
+        case '\\':
+            escaped += "\\\\";
+            break;
+        case '"':
+            escaped += "\\\"";
+            break;
+        case '\n':
+            escaped += "\\n";
+            break;
+        case '\r':
+            escaped += "\\r";
+            break;
+        case '\t':
+            escaped += "\\t";
+            break;
+        default:
+            if (static_cast<unsigned char>(ch) >= 0x20) {
+                escaped += ch;
+            }
+            break;
+        }
+    }
+    return escaped;
+}
+
+bool base64Decode(const char* encoded, std::vector<uint8_t>* decoded)
+{
+    if (encoded == nullptr || decoded == nullptr || encoded[0] == '\0') {
+        return false;
+    }
+    const size_t encoded_len = std::strlen(encoded);
+    size_t required = 0;
+    int ret = mbedtls_base64_decode(nullptr, 0, &required,
+                                    reinterpret_cast<const unsigned char*>(encoded), encoded_len);
+    if (ret != MBEDTLS_ERR_BASE64_BUFFER_TOO_SMALL || required == 0) {
+        return false;
+    }
+    decoded->assign(required, 0);
+    size_t actual = 0;
+    ret = mbedtls_base64_decode(decoded->data(), decoded->size(), &actual,
+                                reinterpret_cast<const unsigned char*>(encoded), encoded_len);
+    if (ret != 0 || actual == 0 || actual > decoded->size()) {
+        decoded->clear();
+        return false;
+    }
+    decoded->resize(actual);
+    return true;
+}
+
+bool base64Encode(const uint8_t* data, size_t len, std::string* encoded)
+{
+    if (data == nullptr || len == 0 || encoded == nullptr) {
+        return false;
+    }
+    size_t required = 0;
+    int ret = mbedtls_base64_encode(nullptr, 0, &required, data, len);
+    if (ret != MBEDTLS_ERR_BASE64_BUFFER_TOO_SMALL || required == 0) {
+        return false;
+    }
+    std::vector<unsigned char> buffer(required + 1, 0);
+    size_t actual = 0;
+    ret = mbedtls_base64_encode(buffer.data(), buffer.size(), &actual, data, len);
+    if (ret != 0 || actual == 0) {
+        return false;
+    }
+    encoded->assign(reinterpret_cast<const char*>(buffer.data()), actual);
+    return true;
+}
+
+bool bytesToPCM16(const std::vector<uint8_t>& bytes, std::vector<int16_t>* samples)
+{
+    if (samples == nullptr || bytes.empty() || (bytes.size() % 2) != 0) {
+        return false;
+    }
+    samples->assign(bytes.size() / 2, 0);
+    for (size_t i = 0; i < samples->size(); ++i) {
+        const uint16_t lo = bytes[i * 2];
+        const uint16_t hi = bytes[i * 2 + 1];
+        (*samples)[i] = static_cast<int16_t>(lo | (hi << 8));
+    }
+    return true;
+}
+
+std::vector<uint8_t> pcm16ToLittleEndianBytes(const int16_t* samples, size_t count)
+{
+    std::vector<uint8_t> bytes(count * 2, 0);
+    for (size_t i = 0; i < count; ++i) {
+        const uint16_t value = static_cast<uint16_t>(samples[i]);
+        bytes[i * 2] = static_cast<uint8_t>(value & 0xff);
+        bytes[i * 2 + 1] = static_cast<uint8_t>((value >> 8) & 0xff);
+    }
+    return bytes;
+}
+
+void downsampleInputToA21PCM16(const std::vector<int16_t>& input, int input_channels, int16_t* output)
+{
+    input_channels = std::max(input_channels, 1);
+    for (int out = 0; out < kMicOutputFramesPerChunk; ++out) {
+        const int in_frame = std::min((out * kMicInputSampleRateHz) / kMicOutputSampleRateHz,
+                                      kMicInputFramesPerChunk - 1);
+        output[out] = input[in_frame * input_channels];
+    }
+}
+
+void copyOrUpsampleToOutputRate(const std::vector<int16_t>& input, int sample_rate_hz, A21PCMFrame* frame)
+{
+    const int output_rate = g_codec != nullptr && g_codec->output_sample_rate() > 0 ? g_codec->output_sample_rate() : 24000;
+    frame->sample_rate_hz = output_rate;
+    if (sample_rate_hz == output_rate) {
+        frame->frame_count = std::min(input.size(), static_cast<size_t>(kMaxOutputFrames));
+        std::copy_n(input.begin(), frame->frame_count, frame->samples);
+        return;
+    }
+
+    const size_t out_count = std::min(static_cast<size_t>(
+                                          (static_cast<uint64_t>(input.size()) * output_rate) /
+                                          static_cast<uint64_t>(sample_rate_hz)),
+                                      static_cast<size_t>(kMaxOutputFrames));
+    frame->frame_count = out_count;
+    for (size_t out = 0; out < out_count; ++out) {
+        const size_t in = std::min((out * static_cast<size_t>(sample_rate_hz)) /
+                                       static_cast<size_t>(output_rate),
+                                   input.size() - 1);
+        frame->samples[out] = input[in];
+    }
+}
+
+std::string makeA21Envelope(const std::string& kind,
+                            uint64_t seq,
+                            const std::string& trace_id,
+                            const std::string& session_id,
+                            const std::string& payload)
+{
+    std::string json = "{\"protocol\":\"a21.device.v1\",\"device_id\":\"" + jsonEscape(g_device_id) +
+                       "\",\"kind\":\"" + kind + "\",\"seq\":" + std::to_string(seq);
+    if (!trace_id.empty()) {
+        json += ",\"trace_id\":\"" + jsonEscape(trace_id) + "\"";
+    }
+    if (!session_id.empty()) {
+        json += ",\"session_id\":\"" + jsonEscape(session_id) + "\"";
+    }
+    json += ",\"payload\":" + payload + "}";
+    return json;
+}

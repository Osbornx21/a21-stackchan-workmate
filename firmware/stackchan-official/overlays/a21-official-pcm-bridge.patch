+std::string withDeviceIDQuery(std::string url)
+{
+    if (url.empty() || url.find("device_id=") != std::string::npos) {
+        return url;
+    }
+    url += (url.find('?') == std::string::npos) ? "?" : "&";
+    url += "device_id=" + g_device_id;
+    return url;
+}

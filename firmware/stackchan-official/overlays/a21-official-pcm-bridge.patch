+std::string readAudioWSURL()
+{
+    Settings settings(kSettingsNamespace, false);
+    g_device_id = settings.GetString("device_id", kDefaultDeviceID);
+    return withDeviceIDQuery(settings.GetString("audio_ws_url", ""));
+}

+bool enqueueAudioPlaybackChunk(const cJSON* root)
+{
+    if (root == nullptr || g_audio_queue == nullptr) {
+        return false;
+    }
+    const cJSON* payload = cJSON_GetObjectItem(root, "payload");
+    if (!cJSON_IsObject(payload)) {
+        return false;
+    }
+    const cJSON* codec = cJSON_GetObjectItem(payload, "codec");
+    const cJSON* sample_rate = cJSON_GetObjectItem(payload, "sample_rate_hz");
+    const cJSON* channels = cJSON_GetObjectItem(payload, "channels");
+    const cJSON* duration = cJSON_GetObjectItem(payload, "duration_ms");
+    const cJSON* data = cJSON_GetObjectItem(payload, "data_base64");
+    if (!cJSON_IsString(codec) || std::strcmp(codec->valuestring, "pcm_s16le") != 0 ||
+        !cJSON_IsNumber(sample_rate) || !cJSON_IsNumber(channels) ||
+        !cJSON_IsNumber(duration) || !cJSON_IsString(data) ||
+        channels->valueint != 1 || duration->valueint <= 0 || duration->valueint > 100 ||
+        (sample_rate->valueint != 16000 && sample_rate->valueint != 24000)) {
+        return false;
+    }
+
+    std::vector<uint8_t> decoded;
+    std::vector<int16_t> samples;
+    if (!base64Decode(data->valuestring, &decoded) || !bytesToPCM16(decoded, &samples)) {
+        return false;
+    }
+
+    A21PCMFrame frame;
+    frame.duration_ms = duration->valueint;
+    copyOrUpsampleToOutputRate(samples, sample_rate->valueint, &frame);
+    if (frame.frame_count == 0) {
+        return false;
+    }
+    if (xQueueSend(g_audio_queue, &frame, 0) != pdTRUE) {
+        g_dropped_chunks += 1;
+        return true;
+    }
+    return true;
+}
+
+void applyControlEvent(const cJSON* root)
+{
+    if (root == nullptr || g_audio_queue == nullptr) {
+        return;
+    }
+    const cJSON* payload = cJSON_GetObjectItem(root, "payload");
+    const cJSON* state = cJSON_IsObject(payload) ? cJSON_GetObjectItem(payload, "state") : nullptr;
+    if (cJSON_IsString(state)) {
+        setStatus(state->valuestring);
+        if (std::strcmp(state->valuestring, "speaking") != 0) {
+            xQueueReset(g_audio_queue);
+        }
+    }
+}
+
+void handleTextMessage(const char* data, size_t len)
+{
+    std::string message(data, data + len);
+    std::unique_ptr<cJSON, decltype(&cJSON_Delete)> root(cJSON_Parse(message.c_str()), cJSON_Delete);
+    if (!root) {
+        g_invalid_messages += 1;
+        return;
+    }
+    const cJSON* kind = cJSON_GetObjectItem(root.get(), "kind");
+    if (!cJSON_IsString(kind)) {
+        g_invalid_messages += 1;
+        return;
+    }
+    if (std::strcmp(kind->valuestring, "audio.playback.chunk") == 0) {
+        if (!enqueueAudioPlaybackChunk(root.get())) {
+            g_invalid_messages += 1;
+        }
+        return;
+    }
+    if (std::strcmp(kind->valuestring, "control.event") == 0) {
+        applyControlEvent(root.get());
+    }
+}
+
+void audioOutputTask(void*)
+{
+    A21PCMFrame frame;
+    while (true) {
+        if (xQueueReceive(g_audio_queue, &frame, portMAX_DELAY) != pdTRUE) {
+            continue;
+        }
+        if (g_codec == nullptr || frame.frame_count == 0) {
+            continue;
+        }
+        std::vector<int16_t> chunk(frame.samples, frame.samples + frame.frame_count);
+        g_codec->OutputData(chunk);
+        g_played_chunks += 1;
+    }
+}
+
+std::unique_ptr<WebSocket> connectAudioWebSocket(const std::string& url)
+{
+    auto* network = Board::GetInstance().GetNetwork();
+    if (network == nullptr) {
+        return nullptr;
+    }
+    auto ws = network->CreateWebSocket(1);
+    if (ws == nullptr) {
+        return nullptr;
+    }
+    ws->SetReceiveBufferSize(4096);
+    ws->SetHeader("Device-Id", g_device_id.c_str());
+    ws->SetHeader("A21-Device-Role", "stackchan-official-pcm-bridge");
+    ws->OnConnected([]() { setStatus("ws connected"); });
+    ws->OnDisconnected([]() { setStatus("ws disconnected"); });
+    ws->OnError([](int error) {
+        ESP_LOGW(kTag, "websocket error=%d", error);
+        setStatus("ws error");
+    });
+    ws->OnData([](const char* data, size_t len, bool binary) {
+        if (binary) {
+            return;
+        }
+        handleTextMessage(data, len);
+    });
+    if (!ws->Connect(url.c_str())) {
+        ESP_LOGW(kTag, "connect failed: error=%d", ws->GetLastError());
+        return nullptr;
+    }
+    return ws;
+}
+
+void waitForNetwork()
+{
+    setStatus("wifi starting");
+    renderStatus();
+    Board::GetInstance().SetNetworkEventCallback([](NetworkEvent event, const std::string&) {
+        if (event == NetworkEvent::Connected) {
+            g_network_connected = true;
+            setStatus("wifi connected");
+        } else if (event == NetworkEvent::Disconnected) {
+            g_network_connected = false;
+            setStatus("wifi disconnected");
+        } else if (event == NetworkEvent::WifiConfigModeEnter) {
+            setStatus("wifi config");
+        }
+    });
+    Board::GetInstance().StartNetwork();
+    while (!g_network_connected.load()) {
+        renderStatus();
+        idleDelay(500);
+    }
+}
+

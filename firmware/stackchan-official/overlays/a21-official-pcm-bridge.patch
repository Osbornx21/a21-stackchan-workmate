+bool base64Decode(const char* encoded, std::vector<uint8_t>* decoded)
+{
+    if (encoded == nullptr || decoded == nullptr || encoded[0] == '\0') {
+        return false;
+    }
+    const size_t encoded_len = std::strlen(encoded);
+    size_t required = 0;
+    int ret = mbedtls_base64_decode(nullptr, 0, &required,
+                                    reinterpret_cast<const unsigned char*>(encoded), encoded_len);
+    if (ret != MBEDTLS_ERR_BASE64_BUFFER_TOO_SMALL || required == 0) {
+        return false;
+    }
+    decoded->assign(required, 0);
+    size_t actual = 0;
+    ret = mbedtls_base64_decode(decoded->data(), decoded->size(), &actual,
+                                reinterpret_cast<const unsigned char*>(encoded), encoded_len);
+    if (ret != 0 || actual == 0 || actual > decoded->size()) {
+        decoded->clear();
+        return false;
+    }
+    decoded->resize(actual);
+    return true;
+}
+
+bool bytesToPCM16(const std::vector<uint8_t>& bytes, std::vector<int16_t>* samples)
+{
+    if (samples == nullptr || bytes.empty() || (bytes.size() % 2) != 0) {
+        return false;
+    }
+    samples->assign(bytes.size() / 2, 0);
+    for (size_t i = 0; i < samples->size(); ++i) {
+        const uint16_t lo = bytes[i * 2];
+        const uint16_t hi = bytes[i * 2 + 1];
+        (*samples)[i] = static_cast<int16_t>(lo | (hi << 8));
+    }
+    return true;
+}
+
+void copyOrUpsampleToOutputRate(const std::vector<int16_t>& input, int sample_rate_hz, A21PCMFrame* frame)
+{
+    const int output_rate = g_codec != nullptr && g_codec->output_sample_rate() > 0 ? g_codec->output_sample_rate() : 24000;
+    frame->sample_rate_hz = output_rate;
+    if (sample_rate_hz == output_rate) {
+        frame->frame_count = std::min(input.size(), static_cast<size_t>(kMaxOutputFrames));
+        std::copy_n(input.begin(), frame->frame_count, frame->samples);
+        return;
+    }
+
+    const size_t out_count = std::min(static_cast<size_t>(
+                                          (static_cast<uint64_t>(input.size()) * output_rate) /
+                                          static_cast<uint64_t>(sample_rate_hz)),
+                                      static_cast<size_t>(kMaxOutputFrames));
+    frame->frame_count = out_count;
+    for (size_t out = 0; out < out_count; ++out) {
+        const size_t in = std::min((out * static_cast<size_t>(sample_rate_hz)) /
+                                       static_cast<size_t>(output_rate),
+                                   input.size() - 1);
+        frame->samples[out] = input[in];
+    }
+}
